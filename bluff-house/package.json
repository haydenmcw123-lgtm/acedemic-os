{
  "name": "bluff-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "plans": "tsx scripts/gen-plans.ts",
    "assets": "tsx scripts/fetch-assets.ts",
    "bake:export": "tsx scripts/bake-export.ts",
    "bake": "tsx scripts/bake-export.ts && blender -b -P scripts/bake.py -- bake public/lightmaps"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
